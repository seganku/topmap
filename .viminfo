	<style>
	  body {
	    margin: 0;
	    background: #222;
	    color: #fff;
	    font-family: sans-serif;
	  }
	
	  .main-layout {
	    display: flex;
	    flex-direction: row;
	    flex-wrap: wrap;
	    justify-content: center;
	    align-items: flex-start;
	    padding: 1em;
	    gap: 1em;
	  }
	
	  .sidebar {
	    max-width: 240px;
	    flex: 1 1 200px;
	    display: flex;
	    flex-direction: column;
	    align-items: center;
	    gap: 1em;
	  }
	
	  .new-link button {
	    background: #444;
	    color: #fff;
	    border: 2px solid #888;
	    padding: 0.5em 1em;
	    font-size: 1em;
	    border-radius: 6px;
	    cursor: pointer;
	  }
	
	  .new-link button:hover {
	    background: #666;
	  }
	
	  .controls label {
	    margin-right: 0.5em;
	  }
	
	  .swatches {
	    margin-top: 1em;
	  }
	
